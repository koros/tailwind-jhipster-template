# SonarQube Configuration
# Copy this file to .env.sonar and fill in the values
# The setup script will generate SONAR_TOKEN automatically

# SonarQube server URL
SONAR_HOST_URL=http://localhost:9001

# SonarQube authentication token
# Generated automatically by: npm run sonar:setup
# For CI/CD, set this as a secure environment variable
SONAR_TOKEN=your-token-here

# Optional: Override default admin credentials
# SONAR_USER=admin
# SONAR_PASS=admin
